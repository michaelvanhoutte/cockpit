# Copy to .env and fill in (copy, don't rename — this template should stay in the repo).
# .env is gitignored. Never commit a real token.

# Internal integration token from https://www.notion.so/profile/integrations
# Starts with ntn_ (older integrations start with secret_).
NOTION_TOKEN=ntn_

# Which API version to send in the Notion-Version header. 2026-03-11 is the current
# one; 2025-09-03 and later are the versions that expose data sources, which this POC
# relies on for database queries.
NOTION_VERSION=2026-03-11

# --- Who "me" is -----------------------------------------------------------------
# This is the single most important setting, and the easiest to get wrong.
#
# The token authenticates a *bot*, not you. "Assigned to me" and "mentions me" have to
# match your *person* user id, which is a different id from the bot's. The harness
# resolves it from NOTION_PERSON_EMAIL by listing workspace users, which needs the
# integration's "Read user information including email addresses" capability. If that
# capability is off, paste the id directly instead.
#
# To find the id by hand: mention yourself in any page, then read that page through
# the API — the mention carries your user id. Or turn the capability on for one run.
NOTION_PERSON_EMAIL=
NOTION_PERSON_USER_ID=
NOTION_PERSON_NAME=

# Self-declared, because the API does not report it. Recorded in the report so a run
# always says which plan it was produced on: free | plus | business | enterprise
NOTION_PLAN=free

# --- Crawl budget ----------------------------------------------------------------
# Document mentions and comments cannot be searched for, only crawled, so the crawl
# budget *is* the coverage. These caps keep a probe run from turning into a full
# workspace sweep; the report says how much was left uncrawled.
MAX_PAGES=40
MAX_BLOCK_DEPTH=2

# Inline comments are anchored to individual blocks, and GET /v1/comments takes one block at
# a time, so covering them costs one request per block.
#
# On by default anyway, because measurement showed the alternative is worse: an ordinary
# comment made by selecting text is a *block* comment, and querying the page id does not
# return it. With this off, a page that visibly has a comment mentioning you reports zero.
# Set to 0 only when you are deliberately measuring the cheaper, incomplete sweep.
DEEP_COMMENTS=1

# --- Ground truth ----------------------------------------------------------------
# Optional, but this is what turns "some results came back" into a recall measurement.
# Paste the URL of a page you *know* contains each thing (Notion page ··· menu → Copy link).
#
# A page whose body text @-mentions you (not the title — the body).
EXPECT_MENTION_PAGE_URL=
# A page with a comment that @-mentions you.
EXPECT_COMMENT_MENTION_PAGE_URL=
# A page with a comment thread you started that somebody else replied to.
EXPECT_REPLY_PAGE_URL=
# A page where you have already *resolved* a comment thread. Used to confirm that
# resolved comments are invisible to the API, which is the whole "handled" question.
EXPECT_RESOLVED_COMMENT_PAGE_URL=

# How far back the "new since" probes look, in days.
LOOKBACK_DAYS=7

# Notion documents an average of ~3 requests/second per connection. 350ms keeps the
# crawl just inside that. Raise it if you start seeing 429s.
REQUEST_INTERVAL_MS=350

PORT=4331

# Port for the webhook receiver (npm run webhook). Notion requires a public HTTPS
# URL, so this needs a tunnel in front of it — see the README.
WEBHOOK_PORT=4332
