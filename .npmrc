# Refuse to install on a Node outside `engines`, rather than warning and
# carrying on: without this, pnpm prints "WARN Unsupported engine" and installs
# anyway, so the floor readme.md explains would not hold.
#
# It gates every dependency's `engines` too, not only this workspace's. That is
# the cost: a dependency whose range excludes our Node fails the install
# outright instead of warning, and the message names the package.
engine-strict=true
