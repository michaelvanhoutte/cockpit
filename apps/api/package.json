{
  "name": "@cockpit/api",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker: HTTP API + SSE + queue consumers + cron triggers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:fast": "pnpm test:unit",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cockpit --local",
    "db:seed:local": "wrangler d1 execute cockpit --local --file=./seed.sql"
  },
  "dependencies": {
    "@cockpit/connector-sdk": "workspace:*",
    "@cockpit/shared": "workspace:*",
    "@hono/zod-openapi": "^1.5.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@cockpit/config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
