{
  "name": "@cockpit/test-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Derives which product concepts own which tests, as the model the Harness Monitor's Tests page draws. See docs/test-explorer-spec.md.",
  "scripts": {
    "generate": "node src/cli.js",
    "check-concepts": "node src/cli.js --check-concepts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:fast": "pnpm test:unit",
    "test:all": "vitest run",
    "test:coverage": "vitest run"
  },
  "dependencies": {
    "istanbul-lib-coverage": "^3.2.2",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
