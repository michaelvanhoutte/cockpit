{
  "name": "cockpit",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @cockpit/api dev",
    "dev:web": "pnpm --filter @cockpit/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "test": "pnpm -r test",
    "test:fast": "pnpm -r test:fast",
    "test:all": "pnpm -r test:all && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:coverage": "pnpm -r test:coverage",
    "test:explorer": "pnpm --filter @cockpit/test-explorer generate",
    "test:explorer:check": "pnpm --filter @cockpit/test-explorer check-concepts",
    "branches:tidy": "node scripts/tidy-branches.mjs"
  },
  "devDependencies": {
    "@cockpit/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
