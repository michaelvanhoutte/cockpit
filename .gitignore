# Claude Code session files (local preview config, worktree checkouts)
.claude/launch.json
.claude/worktrees/

# Where the backup commands read each environment's operator token from
# (backup-tokens.example.json shows the shape). Secrets live in the platform in
# a deployed environment; this is the local copy that lets a command reach one.
backup-tokens.json

node_modules/
dist/
coverage/
.wrangler/
.dev.vars
*.local
.env
.env.*
!.env.example
*.tsbuildinfo
.DS_Store

# Playwright (F3): failure artefacts, regenerated on every run
test-results/
playwright-report/

# Backups, and the staging directory a run that did not finish leaves behind
# (`pnpm backup:export`). A backup holds every user's address and Google
# identity and every account's rows, and this repository is public. `--out` is
# resolved against the working directory rather than the checkout, so one
# written here is somebody choosing to; these two lines are what stops that
# choice becoming a commit.
backups/
*.partial
