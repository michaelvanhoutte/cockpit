{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Harness Monitor: its own Worker and its own D1 database, sharing no
  // code or binding with Cockpit, and one secret value, USAGE_READ_TOKEN
  // (docs/architecture.md, "The Harness Monitor").
  "name": "harness-monitor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  "preview_urls": false,
  "observability": { "logs": { "enabled": true } },

  // The pages' font, served by the Monitor itself: public/fonts holds Inter
  // under a versioned name, and public/_headers caches it for good. Everything
  // else still reaches the Worker (src/look.ts, FONT_URL). The platform answers
  // a file before the Worker runs; the binding exists so a test can ask for one.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Hourly: link branches to pull requests (src/linking.ts). Daily, 03:10 UTC:
  // fetch the price list and price the rows waiting for one. 03:20 UTC: rebuild
  // the daily totals from the rows. 00:30 and 12:30 UTC: copy Cockpit's Claude
  // calls from production (src/claude-calls.ts). Separate schedules, so each
  // stays inside the free plan's 50 queries per invocation.
  "triggers": { "crons": ["0 * * * *", "10 3 * * *", "20 3 * * *", "30 */12 * * *"] },
  // PAGE_CACHE_SECONDS: how long the edge keeps the public costs page (src/worker.ts).
  // COCKPIT_URL: production's address, which the import reads its calls from.
  "vars": {
    "GITHUB_REPOSITORY": "michaelvanhoutte/cockpit",
    "PAGE_CACHE_SECONDS": "300",
    "COCKPIT_URL": "https://cockpit.vanhoutte-michael.workers.dev"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harness-monitor",
      // A placeholder. The deploy workflow swaps in the repository variable
      // HARNESS_MONITOR_DATABASE_ID before it migrates or deploys; local runs
      // and tests never read it (docs/deployment.md, "The Harness Monitor").
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // GITHUB_TOKEN, HARNESS_WRITE_KEY and USAGE_READ_TOKEN are secrets (`wrangler secret put`), so they are not here.
  // Locally scripts/dev-harness.mjs passes a local-only value with --var.
}
