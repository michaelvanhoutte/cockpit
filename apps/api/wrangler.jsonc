{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves the whole application: the Hono API, SSE, the queue
  // consumers, the cron triggers, AND the built SPA as static assets
  // (architecture, "Hosting, CI/CD, and observability"). Hence "cockpit", not
  // "cockpit-api".
  "name": "cockpit",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",

  // Static assets (apps/web/dist) are served *before* the Worker runs, so a
  // cold page load bills no Worker invocation. Only the three API prefixes
  // reach the Worker; everything else falls back to index.html for the SPA
  // router.
  //
  // The service worker refuses to intercept these same three
  // (navigateFallbackDenylist in apps/web/vite.config.ts) — add a prefix to one
  // list and it belongs in the other. That list carries a fourth, `/cdn-cgi/`,
  // which deliberately does **not** belong here: it is Cloudflare's own, and
  // the edge answers it before assets or this Worker see it. So the two lists
  // agree about this application's prefixes and about nothing else.
  //
  // `assets` and `observability` are *inheritable* config keys, so the staging
  // environment below gets them for free. `d1_databases` (and `vars`, `queues`,
  // `secrets`, `durable_objects`) are NOT inheritable and must be repeated per
  // environment — that is deliberate on Cloudflare's part, and it is the
  // mechanism that keeps staging off the production database (see docs/deployment.md).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health", "/ingress/*"]
  },

  "observability": {
    "logs": {
      "enabled": true
    }
  },

  // No per-version preview URLs on either environment. Nothing here would get
  // them anyway - Cloudflare withholds them from a Worker that implements a
  // Durable Object, which is what took the preview environment with it
  // (docs/deployment.md, "No branch environments"). This stays off explicitly
  // so that is a decision rather than a platform default nobody chose, and
  // staging repeats it below for the same reason, inheritable or not.
  "preview_urls": false,

  // One Durable Object per account, holding that account's workspaces, items,
  // associations and change log (docs/account-storage-options.md). The binding
  // names a *namespace*, never one account: an account is reached by name at
  // runtime, created on first touch, and appears in no configuration - which is
  // why provisioning one needs no deploy and nothing here can drift out of step
  // with live infrastructure.
  //
  // `durable_objects` is NOT inheritable, so it is repeated per environment
  // below, for the same reason `d1_databases` is. `migrations` IS inheritable
  // and is therefore declared once, at the top level.
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNT",
        "class_name": "AccountStore"
      }
    ]
  },

  // SQLite-backed, which is what gives an account real transactions rather than
  // D1's batch-only model. `new_sqlite_classes` is the only correct choice for
  // a class that has never been deployed; a class already live as key-value
  // storage cannot be converted.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AccountStore"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cockpit",
      "database_id": "753ea386-68c0-422e-a237-da7a0c66c40c",
      "migrations_dir": "migrations"
    }
  ],

  // Signing in (docs/architecture.md, "App login: hand-rolled Google OIDC + own
  // sessions"). Two things and not three: `GOOGLE_CLIENT_SECRET` is a secret,
  // so it lives in the platform's secret store and is set per environment by
  // hand (docs/deployment.md, "Secrets and access").
  //
  // **`OIDC_ISSUER` is deliberately absent**, here and in staging. Unset means
  // Google (apps/api/src/auth/issuer.ts); local development and the browser
  // suite set it to point at the stub issuer they run, which is what lets them
  // drive the same flow. A deployed environment that set it would be signing
  // people in against whatever it named, so it is configuration with the weight
  // of a secret.
  //
  // `APP_ORIGIN` is where a sign-in comes back to, and has to be
  // character-for-character one of the redirect URIs registered with the Google
  // client.
  //
  // `vars` is not inheritable, so staging repeats both below.
  "vars": {
    "GOOGLE_CLIENT_ID": "REPLACE-WITH-THE-PRODUCTION-CLIENT-ID.apps.googleusercontent.com",
    "APP_ORIGIN": "https://cockpit.vanhoutte-michael.workers.dev"
  },

  "env": {
    // Staging: the only environment besides production where cron triggers and
    // queue consumers actually run, against a database that accumulates state.
    // That is the whole reason it exists (the branch model in docs/deployment.md).
    "staging": {
      "name": "cockpit-staging",
      "preview_urls": false,
      "durable_objects": {
        "bindings": [
          {
            "name": "ACCOUNT",
            "class_name": "AccountStore"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cockpit-staging",
          "database_id": "ce8bccd3-1e7f-4de0-9005-02e07b3c9ee9",
          "migrations_dir": "migrations"
        }
      ],
      // Its own Google client rather than production's, so a secret that leaks
      // from one environment cannot sign anybody in to the other.
      "vars": {
        "GOOGLE_CLIENT_ID": "REPLACE-WITH-THE-STAGING-CLIENT-ID.apps.googleusercontent.com",
        "APP_ORIGIN": "https://cockpit-staging.vanhoutte-michael.workers.dev"
      }
    }
  }

  // Queues and Cron Triggers (architecture, "Background jobs") are wired when
  // the first connector and
  // enrichment job land. Note when they are: `triggers` is inheritable (so a
  // cron schedule set at the top level would silently also apply to staging,
  // which is what we want) but `queues` is NOT, so each environment needs its
  // own queue names to avoid staging consuming production messages:
  //   "triggers": { "crons": ["*/5 * * * *"] },
  //   "queues": { "producers": [...], "consumers": [...] }
}
