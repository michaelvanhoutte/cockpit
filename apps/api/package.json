{
  "name": "@cockpit/api",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker: HTTP API + SSE + queue consumers + cron triggers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:fast": "pnpm test:unit",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cockpit --local",
    "db:seed:local": "wrangler d1 execute cockpit --local --file=./seed.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.1",
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@cockpit/connector-gmail": "workspace:*",
    "@cockpit/connector-outlook": "workspace:*",
    "@cockpit/connector-sdk": "workspace:*",
    "@cockpit/connector-teams": "workspace:*",
    "@cockpit/connector-twilio": "workspace:*",
    "@cockpit/shared": "workspace:*",
    "@hono/zod-openapi": "^1.5.2",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "jose": "^6.2.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@cockpit/config": "workspace:*",
    "@vitest/coverage-istanbul": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.128.0"
  }
}
