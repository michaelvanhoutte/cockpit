# Copy to .env and fill in (copy, don't rename — this template should stay in the repo).
# .env is gitignored. Never commit a real token.

# User OAuth token from your Slack app's "OAuth & Permissions" page. Starts with xoxp-.
# A bot token (xoxb-) will NOT work here: bot calls to assistant.search.context require
# an action_token that only arrives inside a Slack event payload.
SLACK_USER_TOKEN=xoxp-

# Optional. If left empty the harness reads it from auth.test.
SLACK_USER_ID=

# Recall checks for the probe battery (npm run probe). Paste the permalink of a Slack
# message you know mentions you, and of a DM you know you received
# (Slack: message "..." menu -> Copy link). The probes then report whether the API
# actually returned those specific messages, which turns "some results came back"
# into a real recall measurement.
EXPECT_MENTION_PERMALINK=
EXPECT_DM_PERMALINK=

# Completeness check (npm run completeness). Comma-separated permalinks of messages you
# know exist in the window. Reports which ones the broad query failed to return.
# Include the awkward cases: an emoji-only message, a link-only message, a file upload,
# a thread reply, a message with accented characters.
EXPECT_ALL_DM_PERMALINKS=
EXPECT_ALL_MENTION_PERMALINKS=

# How far back the probes look, in days.
LOOKBACK_DAYS=7

# Slack documents ~10 requests/min per user. Lower this only if your workspace has a
# higher ceiling; raising the rate risks 429s mid-battery.
PROBE_INTERVAL_MS=6500

PORT=4321
