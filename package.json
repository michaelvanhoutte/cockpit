{
  "name": "cockpit",
  "private": true,
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": "^24.16"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --only api",
    "dev:web": "node scripts/dev.mjs --only web",
    "dev:harness": "node scripts/dev-harness.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r test",
    "test:fast": "pnpm -r test:fast && pnpm test:scripts && pnpm test:lint && pnpm test:runners",
    "test:all": "pnpm -r test:all && pnpm test:scripts && pnpm test:lint && pnpm test:runners && pnpm test:e2e:ceilings && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ceilings": "node scripts/e2e-ceilings.mjs",
    "test:scripts": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/lib/node-test-session-reporter.mjs --test-reporter-destination=stdout scripts/lib/*.test.mjs",
    "test:lint": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/lib/node-test-session-reporter.mjs --test-reporter-destination=stdout tests/lint/*.test.mjs",
    "test:runners": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/lib/node-test-session-reporter.mjs --test-reporter-destination=stdout tests/runners/*.test.mjs",
    "test:coverage": "pnpm -r test:coverage",
    "test:explorer": "pnpm --filter @cockpit/test-explorer generate",
    "test:explorer:check": "pnpm --filter @cockpit/test-explorer check-concepts",
    "stability": "pnpm --filter @cockpit/ci-stability generate",
    "cycle-time": "pnpm --filter @cockpit/cycle-time generate",
    "selection": "pnpm --filter @cockpit/selection generate",
    "architecture": "pnpm --filter @cockpit/architecture generate",
    "backup:export": "node scripts/backup-export.mjs",
    "backup:restore": "node scripts/backup-restore.mjs",
    "usage:export": "node scripts/usage-export.mjs",
    "guest:reset": "node scripts/guest-reset.mjs",
    "duplicates:backfill": "node scripts/duplicates-backfill.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "branches:tidy": "node scripts/tidy-branches.mjs",
    "cost:issue": "node scripts/issue-cost.mjs",
    "harness:upload": "node scripts/harness-upload.mjs",
    "harness:run": "node scripts/harness-run.mjs"
  },
  "devDependencies": {
    "@cockpit/config": "workspace:*",
    "@cockpit/shared": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3"
  }
}
