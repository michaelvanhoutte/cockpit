  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@cockpit/config": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
